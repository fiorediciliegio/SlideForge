{
  "slug": "aps-cleanup",
  "name": "APS Cleanup",
  "version": "0.1.0",
  "description": "Local demo for clearing a confirmed directory in personal APS.",
  "executa_type": "tool",
  "tool_id": "tool-local-aps-cleanup-demo",
  "type": "node",
  "command": [
    "node",
    "plugin.js"
  ],
  "enabled": true,
  "distribution": {
    "active": "local",
    "profiles": {
      "local": {
        "type": "local",
        "supports_protocol": true,
        "capabilities": [
          "list_directory",
          "delete_file"
        ]
      }
    }
  }
}
