{
  "name": "slideforge",
  "private": true,
  "version": "0.1.0",
  "description": "SlideForge — AI presentation workspace: HTML-native slides, deterministic design fidelity, editable PPTX export.",
  "type": "module",
  "scripts": {
    "validate:visual-style-presets": "node ./scripts/validate-visual-style-presets.mjs",
    "audit:template-fonts": "node ./scripts/audit-template-fonts.mjs",
    "dedupe:template-fonts": "node ./scripts/dedupe-embedded-template-fonts.mjs",
    "restore:semantic-template-fonts": "node ./scripts/restore-semantic-template-fonts.mjs",
    "preset-previews:render": "npm --prefix ./tools/visual-style-preset-preview-renderer run render --",
    "preset-previews:convert": "npm --prefix ./tools/visual-style-preset-preview-renderer run convert-images --",
    "preset-previews:check": "npm --prefix ./tools/visual-style-preset-preview-renderer run check --",
    "preset-previews:test": "npm --prefix ./tools/visual-style-preset-preview-renderer test",
    "dev": "node scripts/dev-services.mjs",
    "dev:legacy": "npm run serve",
    "generate": "node --import tsx/esm scripts/m0-generate.ts",
    "mcp": "node --import tsx/esm src/mcp/server.ts",
    "serve": "node --import tsx/esm src/http/capabilityServer.ts",
    "serve:engine": "node --import tsx/esm src/http/engineServer.ts",
    "serve:brain": "cd services/brain && python -m brain.app",
    "serve:gateway": "cd services/gateway && go run ./cmd/gateway",
    "test:gateway": "cd services/gateway && go test ./... && go vet ./...",
    "test:integration": "node scripts/integration-up.mjs",
    "test:brain": "cd services/brain && python -m unittest discover -s tests -v",
    "mcp:smoke": "node --import tsx/esm scripts/mcp-smoke.ts",
    "ci:fidelity": "node --import tsx/esm scripts/ci-fidelity.ts",
    "check": "tsc --noEmit",
    "test:core": "node --import tsx/esm --test tests/contracts/**/*.test.ts tests/capabilities/**/*.test.ts tests/server/**/*.test.ts",
    "test:unit": "node --import tsx/esm --test tests/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.17",
    "sharp": "^0.34.5",
    "tsx": "^4.22.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
