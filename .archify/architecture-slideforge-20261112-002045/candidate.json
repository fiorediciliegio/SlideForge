  "cards": [
    {
      "dot": "emerald",
      "title": "Agent 闭环在哪里",
      "items": [
        "Brain 调模型选择工具 → Node 执行 → 返回观察证据 → Brain 决定修订或完成。",
        "版面检查和截图由独立引擎执行；内容与视觉判断回到 Brain。",
        "默认直接生成；也可先确认可编辑大纲。当前新 Harness 首先接入 Web。"
      ]
    },
    {
      "dot": "cyan",
      "title": "文件如何流动",
      "items": [
        "Node 上传固定 HTML / 资源快照，Go 返回 artifact ID 和引擎任务 ID。",
        "引擎从 Go 拉取输入，在自己的临时目录执行，再上传报告、截图和导出文件。",
        "业务与引擎不共享本地目录；导出完成后 Go 幂等扣点，客户带业务 Key 下载。"
      ]
    },
    {
      "dot": "violet",
      "title": "哪些资料会被保存",
      "items": [
        "Node 项目域：原资料、已确认约束、大纲、当前页面、历史版本、模型消息和检查证据。",
        "Go 控制域：执行状态、预算预留与结算、任务租约、幂等回执及当前版本引用。",
        "模型费用预算与导出产品点数是两套独立口径。"
      ]
    },
    {
      "dot": "amber",
      "title": "当前默认并发与部署范围",
      "items": [
        "默认 Brain 同时推进 5 个项目，每份作品页面模型并发 2；引擎每实例 1 个重型作业。",
        "Go 开发环境使用 JSON 与私有文件；生产可配置 PostgreSQL / S3，图中不代表已经完成生产验收。",
        "引擎可独立部署、多实例领取任务；业务 Node 项目目录仍由一个逻辑实例持有。"
      ]
    },
    {
      "dot": "slate",
      "title": "其他入口与图的范围",
      "items": [
        "CLI / MCP 调用同一套 Capability 能力，属于可选入口，主图未逐个展开。",
        "WPS 沿用已有生成 / 导出 / 插入接口，尚未接入 Web 的新 Harness 交互。",
        "四个端口来自 npm run dev 的默认配置；图中将库与辅助模块合并为所属服务。"
      ]
    },
    {
      "dot": "orange",
      "title": "代码证据与版本",
      "items": [
        "按 2026-11-12 当前工作区绘制，包含尚未提交的独立引擎改造及附件修复。",
        "源码行号依据输出目录内独立的本地证据快照校验，不指向旧 HEAD 的未修改版本。",
        "未提交路径、原 HEAD 与源码哈希见同目录「来源说明.md」；制图未修改业务代码。"
      ]
    }
  ]
