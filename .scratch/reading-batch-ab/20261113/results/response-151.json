9443b;}\n  .mk{flex:0 0 auto;width:18px;height:18px;margin-top:5px;border:1px solid rgba(27,38,32,.45);position:relative;}\n  .mk.checked{background:rgba(79,94,67,.16);}\n  .mk.checked:after{content:\"\";position:absolute;left:3px;top:6px;width:10px;height:5px;border-left:2px solid #3f4d36;border-bottom:2px solid #3f4d36;transform:rotate(-45deg);}\n  .mk.planned:after{content:\"\";position:absolute;inset:4px;background:rgba(140,159,178,.75);}\n\n  .side-title{font-size:13px;font-weight:700;letter-spacing:4.4px;color:#5f6a60;margin-bottom:6px;}\n  .note-card{background:rgba(27,38,32,.055);border:1px solid rgba(27,38,32,.16);padding:24px 26px 26px;}\n  .note-card .quote{font-size:22px;line-height:1.62;font-weight:700;color:#22301f;letter-spacing:.4px;}\n  .note-card .quote em{font-style:normal;color:#8a6a26;}\n  .note-card .sub{margin-top:14px;font-size:17px;line-height:1.65;color:#5c665d;}\n\n  .stat-list{display:flex;flex-direction:column;gap:0;margin-top:2px;}\n  .stat-row{display:flex;align-items:baseline;justify-content:space-between;gap:16px;padding:12px 0;border-bottom:1px dashed rgba(27,38,32,.20);}\n  .stat-row:last-child{border-bottom:none;}\n  .stat-k{font-size:17px;color:#4a554c;letter-spacing:.6px;}\n  .stat-v{font-size:20px;font-weight:700;color:#8a6a26;letter-spacing:1px;}\n\n  .footer{position:absolute;left:96px;bottom:44px;width:1728px;z-index:14;display:flex;align-items:flex-end;justify-content:space-between;}\n  .footer .src{font-size:14px;line-height:1.6;letter-spacing:1.4px;color:#6a7469;}\n  .page-no{font-size:16px;font-weight:700;letter-spacing:4px;color:#46524a;}\n  .foot-rule{position:absolute;left:96px;bottom:96px;width:1728px;height:1px;z-index:13;background:rgba(27,38,32,.18);}\n</style>\n</head>\n<body>\n<main class=\"slide\">\n  <div class=\"bg-field\"></div>\n  <div class=\"dot-field dot-top\"></div>\n  <div class=\"dot-field dot-bottom\"></div>\n  <div class=\"soft-prism\"></div>\n  <div class=\"gridline gl1\"></div>\n  <div class=\"gridline gl2\"></div>\n  <div class=\"gridline gl3\"></div>\n\n  <div class=\"register\">\n    <div class=\"r2\"></div>\n    <div class=\"r3\"></div>\n    <div class=\"r4\"></div>\n    <div class=\"r5\"></div>\n  </div>\n\n  <div class=\"top-rule\"></div>\n  <div class=\"left-rule\"></div>\n  <div class=\"rail-tick t1\"></div>\n  <div class=\"top-meta\">镜桥产品体验日方案</div>\n  <div class=\"top-right-meta\">状态说明 · 第 06 节</div>\n  <div class=\"rail-label\">PENDING &amp; DATA NOTES</div>\n\n  <div class=\"head\">\n    <div class=\"eyebrow\">STATE OF PLAY</div>\n    <div class=\"h-title\">待确认事项<span class=\"sep\"> · </span>数据说明</div>\n    <div class=\"h-sub\">区分待确认、已完成与计划中三类状态；本页所有指标均沿用方案中的测试构造值，不作对外承诺。</div>\n  </div>\n  <div class=\"head-rule\"></div>\n\n  <div class=\"wrap\">\n    <div class=\"col-left\">\n      <div class=\"block tone-pending\">\n        <div class=\"block-head\">\n          <span class=\"tag tag-pending\">尚未确定</span>\n          <span class=\"block-title\">三项基础条件保持待确认</span>\n        </div>\n        <div class=\"block-body\">以下事项在方案中尚无结论，不得作为已定事项对外发布。</div>\n        <div class=\"chips\">\n          <span class=\"chip\">活动日期 待确认</span>\n          <span class=\"chip\">场地 待确认</span>\n          <span class=\"chip\">实际预算 待确认</span>\n        </div>\n      </div>\n\n      <div class=\"block tone-done\">\n        <div class=\"block-head\">\n          <span class=\"tag tag-done\">已完成</span>\n          <span class=\"block-title\">整体流程与岗位分工已明确</span>\n        </div>\n        <div class=\"block-body\">\n          方案层面的两项内容已经确定：五个环节的体验流程已排定；四类岗位（主持、引导、技术支持、记录）的分工已明确。\n        </div>\n      </div>\n\n      <div class=\"block tone-plan\">\n        <div class=\"block-head\">\n          <span class=\"tag tag-plan\">计划中</span>\n          <span class=\"block-title\">五个环节按顺序执行</span>\n        </div>\n        <div class=\"block-body\">\n          签到 → 任务说明 → 分组体验 → 问题记录 → 汇总复盘，按此顺序推进；执行节奏以已明确的流程为准。\n        </div>\n      </div>\n    </div>\n\n    <div class=\"col-right\">\n      <div class=\"note-card\">\n        <div class=\"side-title\">DATA NOTE</div>\n        <div class=\"quote\">以上指标均为<em>测试构造值</em>，仅用于方案演练。</div>\n        <div class=\"sub\">本资料为虚构测评材料，数值不代表真实业务结果，也不构成任何成交承诺。</div>\n        <div class=\"stat-list\">\n          <div class=\"stat-row\"><span class=\"stat-k\">邀请名额</span><span class=\"stat-v\">84 人 · 测试构造值</span></div>\n          <div class=\"stat-row\"><span class=\"stat-k\">体验分组 / 时长</span><span class=\"stat-v\">7 组 · 26 分钟</span></div>\n          <div class=\"stat-row\"><span class=\"stat-k\">反馈问题</span><span class=\"stat-v\">9 项</span></div>\n        </div>\n      </div>\n\n      <div class=\"note-card\">\n        <div class=\"side-title\">HANDLING RULE</div>\n        <div class=\"quote\">不要将待确认项视为已定事项对外发布。</div>\n        <div class=\"sub\">对外沟通前需先完成日期、场地、实际预算的确认；确认之前，相关表述一律标注为待确认。</div>\n      </div>\n\n      <div class=\"note-card\">\n        <div class=\"side-title\">OPEN ITEM</div>\n        <div class=\"quote\">问题清单的具体交付格式与责任人待确认。</div>\n        <div class=\"sub\">反馈机制中的该事项仍属未确定，需在执行前补齐。</div>\n      </div>\n    </div>\n  </div>\n\n  <div class=\"foot-rule\"></div>\n  <div class=\"footer\">\n    <div class=\"src\">虚构测评材料 · 指标为测试构造值 · 待确认项不得作为已定事项对外发布</div>\n    <div class=\"page-no\">6 / 6</div>\n  </div>\n</main>\n</body>\n</html>","reasoning_content":""},"logprobs":null,"finish_reason":"stop"}],"usage":{"prompt_tokens":6238,"completion_tokens":4024,"total_tokens":10262,"prompt_tokens_details":{"cached_tokens":640},"completion_tokens_details":{"reasoning_tokens":0},"prompt_cache_hit_tokens":640,"prompt_cache_miss_tokens":5598},"system_fingerprint":"bc19ba97cbe016479903222bb1578db6"}