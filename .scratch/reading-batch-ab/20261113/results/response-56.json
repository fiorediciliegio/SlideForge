bsolute;inset:28px;border-radius:50%;\n    background:conic-gradient(from 210deg,rgba(79,94,67,.18),rgba(79,94,67,0) 24%,rgba(140,159,178,.28) 50%,rgba(140,159,178,.07) 78%,rgba(79,94,67,.18));}\n  .register .r4{position:absolute;inset:40px;border-radius:50%;background:rgba(245,242,233,.9);border:1px solid rgba(27,38,32,.08);}\n  .register .r5{position:absolute;inset:58px;border-radius:50%;background:rgba(180,145,74,.20);border:1px solid rgba(27,38,32,.09);}\n\n  /* ---------- header ---------- */\n  .eyebrow{position:absolute;left:96px;top:126px;z-index:12;\n    font-size:14px;font-weight:700;letter-spacing:6px;color:var(--theme-accent-secondary);}\n  .eyebrow .bar{display:inline-block;width:44px;height:2px;background:var(--theme-accent-secondary);\n    vertical-align:middle;margin-right:16px;transform:translateY(-3px);}\n  .title{position:absolute;left:96px;top:170px;z-index:12;margin:0;\n    font-size:78px;font-weight:700;letter-spacing:1px;line-height:1.16;color:#182219;}\n  .title .accent{color:var(--theme-accent-primary);}\n  .lead{position:absolute;left:100px;top:296px;z-index:12;width:1180px;\n    font-size:23px;font-weight:400;line-height:1.6;color:var(--theme-muted);}\n  .lead b{color:#2c382f;font-weight:700;}\n  .hair{position:absolute;left:96px;top:372px;width:1728px;height:1px;z-index:11;background:rgba(27,38,32,.20);}\n  .hair-thick{position:absolute;left:96px;top:372px;width:186px;height:3px;z-index:12;background:var(--theme-accent-primary);}\n\n  /* ---------- boundary cards ---------- */\n  .grid{\n    position:absolute;left:96px;top:416px;width:1728px;height:512px;z-index:12;\n    display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;\n    column-gap:40px;row-gap:34px;\n  }\n  .card{\n    position:relative;background:rgba(255,255,255,.52);\n    border:1px solid rgba(27,38,32,.14);\n    border-left:3px solid var(--theme-accent-primary);\n    padding:26px 34px 24px 34px;display:flex;flex-direction:column;justify-content:center;\n  }\n  .card .num{\n    position:absolute;right:26px;top:16px;\n    font-family:var(--font-display);font-style:italic;font-size:44px;line-height:1;\n    color:rgba(180,145,74,.75);letter-spacing:1px;\n  }\n  .card .tag{\n    font-size:13px;font-weight:700;letter-spacing:4px;color:var(--theme-accent-primary);\n    margin-bottom:14px;\n  }\n  .card .stmt{\n    font-size:28px;font-weight:700;line-height:1.48;color:#1d2822;\n    max-width:640px;\n  }\n  .card .note{\n    margin-top:12px;font-size:16px;font-weight:400;letter-spacing:.6px;color:#6b756c;\n  }\n  .card.alt{border-left-color:var(--theme-accent-secondary);}\n  .card.alt .tag{color:#9a7c3c;}\n  .card.alt .num{color:rgba(79,94,67,.55);}\n\n  /* ---------- footer ---------- */\n  .foot-rule{position:absolute;left:96px;top:972px;width:1728px;height:1px;z-index:11;background:rgba(27,38,32,.22);}\n  .foot-note{position:absolute;left:96px;top:992px;z-index:12;font-size:16px;letter-spacing:.8px;color:#6b756c;}\n  .foot-note .dot{display:inline-block;width:6px;height:6px;border-radius:50%;background:var(--theme-accent-secondary);\n    vertical-align:middle;margin:0 10px;transform:translateY(-2px);}\n  .page-no{position:absolute;right:96px;bottom:46px;z-index:20;\n    font-size:20px;font-weight:700;letter-spacing:3px;color:#3f4c44;}\n  .page-no .slash{color:var(--theme-accent-secondary);margin:0 6px;}\n</style>\n</head>\n<body>\n<main class=\"slide\">\n  <div class=\"bg-field\"></div>\n  <div class=\"dot-field dot-top\"></div>\n  <div class=\"dot-field dot-bottom\"></div>\n  <div class=\"soft-prism\"></div>\n  <div class=\"edge-prism\"></div>\n  <div class=\"gridline gl1\"></div>\n  <div class=\"gridline gl2\"></div>\n  <div class=\"gridline gl3\"></div>\n\n  <div class=\"register\">\n    <div class=\"r2\"></div>\n    <div class=\"r3\"></div>\n    <div class=\"r4\"></div>\n    <div class=\"r5\"></div>\n  </div>\n\n  <div class=\"top-rule\"></div>\n  <div class=\"left-rule\"></div>\n  <div class=\"rail-tick t1\"></div>\n  <div class=\"rail-tick t2\"></div>\n  <div class=\"top-meta\">溪木咖啡 · 品牌传播</div>\n  <div class=\"top-meta-r\">内部对齐材料 · 虚构测评</div>\n  <div class=\"rail-label\">执行边界 · 事实来源与口径</div>\n\n  <div class=\"eyebrow\"><span class=\"bar\"></span>执行边界 / BOUNDARY</div>\n  <h1 class=\"title\">执行边界：<span class=\"accent\">不越过的事实线</span></h1>\n  <p class=\"lead\">四条边界同时约束<b>对外表述</b>与<b>门店执行口径</b>：资料未记录的，保持未确定；资料中有的，按原样呈现。</p>\n\n  <div class=\"hair\"></div>\n  <div class=\"hair-thick\"></div>\n\n  <div class=\"grid\">\n    <div class=\"card\">\n      <div class=\"num\">01</div>\n      <div class=\"tag\">成效表述</div>\n      <div class=\"stmt\">不使用销售增长或市场排名作为已实现成效</div>\n      <div class=\"note\">传播计划阶段，尚无已记录成果</div>\n    </div>\n    <div class=\"card alt\">\n      <div class=\"num\">02</div>\n      <div class=\"tag\">数字口径</div>\n      <div class=\"stmt\">所有数字仅供测评，不作为业务承诺</div>\n      <div class=\"note\">11家试点门店、5周周期、3类触点、14套素材</div>\n    </div>\n    <div class=\"card alt\">\n      <div class=\"num\">03</div>\n      <div class=\"tag\">缺项处理</div>\n      <div class=\"stmt\">不编造日期、预算或业务成果，缺项保持未确定</div>\n      <div class=\"note\">具体日期、预算、成效指标：未确定</div>\n    </div>\n    <div class=\"card\">\n      <div class=\"num\">04</div>\n      <div class=\"tag\">信息来源</div>\n      <div class=\"stmt\">对外表述以资料为唯一来源，不补充外部事实</div>\n      <div class=\"note\">口号固定为「把日常慢慢喝好」，不改写、不新增主张</div>\n    </div>\n  </div>\n\n  <div class=\"foot-rule\"></div>\n  <div class=\"foot-note\">虚构测评材料<span class=\"dot\"></span>所有数字仅用于测评，不作为业务承诺</div>\n\n  <div class=\"page-no\">6<span class=\"slash\">/</span>6</div>\n</main>\n</body>\n</html>","reasoning_content":"Let me create the final page HTML with the reference visual style: warm paper bg, forest green, gold accents, Archivo-like sans (use system fonts since no external fonts allowed — use \"Helvetica Neue\", Arial, sans-serif), serif for display (Georgia, serif).\n\nLayout: 1920×1080, title 执行边界：不越过的事实线, four boundary points as cards/lines, page number 6/6 bottom right.\n\nDes