en;gap:12px;flex:0 0 auto;}\n  .card-title{display:flex;align-items:baseline;gap:13px;}\n  .idx{font-family:var(--serif);font-size:31px;line-height:1;color:rgba(27,38,32,.34);}\n  .card-title h2{\n    margin:0;font-size:28px;line-height:1.2;font-weight:700;letter-spacing:2px;color:#1B2620;\n  }\n  .tag{\n    flex:0 0 auto;font-size:12px;font-weight:700;letter-spacing:2.4px;line-height:1.2;\n    padding:6px 11px 5px;border:1px solid currentColor;white-space:nowrap;\n  }\n  .c1 .tag{color:var(--accent);background:rgba(79,94,67,.07);}\n  .c2 .tag{color:#8d6f2f;background:rgba(180,145,74,.10);}\n  .c3 .tag{color:#5c7183;background:rgba(140,159,178,.14);}\n  .card-rule{height:1px;background:rgba(27,38,32,.22);margin:20px 0 4px;flex:0 0 auto;}\n\n  /* 条目 */\n  .items{list-style:none;margin:0;padding:0;flex:0 0 auto;}\n  .items li{\n    position:relative;padding:11px 0 11px 26px;\n    border-bottom:1px dashed rgba(27,38,32,.16);\n    font-size:21px;line-height:1.42;color:#243029;\n  }\n  .items li:last-child{border-bottom:0;}\n  .items li:before{\n    content:\"\";position:absolute;left:0;top:22px;width:12px;height:2px;background:var(--accent);\n  }\n  .c2 .items li:before{background:var(--gold);}\n  .items li .n{font-family:var(--serif);font-size:14px;color:rgba(27,38,32,.32);margin-right:9px;}\n  .items li .sub{\n    display:block;margin-top:4px;font-size:16px;line-height:1.4;letter-spacing:.4px;color:#66736a;\n  }\n\n  /* 空状态 */\n  .empty{\n    margin-top:16px;flex:1 1 auto;min-height:0;\n    display:flex;flex-direction:column;align-items:center;justify-content:center;\n    border:1px dashed rgba(92,113,131,.55);background:rgba(140,159,178,.07);padding:18px;\n  }\n  .empty .dash{font-family:var(--serif);font-size:36px;line-height:1;color:rgba(92,113,131,.55);}\n  .empty p{margin:14px 0 0;font-size:21px;line-height:1.55;text-align:center;color:#33454f;font-weight:600;}\n  .empty .note{margin-top:10px;font-size:15px;letter-spacing:1.6px;color:#6b7c88;font-weight:500;}\n\n