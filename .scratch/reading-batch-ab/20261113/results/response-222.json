ontent:\"\";position:absolute;left:-1px;bottom:-1px;width:calc(100% + 2px);height:2px;background:rgba(27,38,32,.14);}\n  .c1{left:96px;} .c2{left:684px;} .c3{left:1272px;}\n  .c1:before{background:var(--p);}\n  .c2:before{background:var(--s);}\n  .c3:before{background:var(--t);}\n  .card-top{display:flex;align-items:baseline;justify-content:space-between;flex:none;}\n  .num{\n    font-family:var(--serif);font-size:36px;line-height:1;font-weight:700;\n    color:rgba(27,38,32,.20);letter-spacing:1px;\n  }\n  .tag{\n    font-size:14px;font-weight:700;letter-spacing:3.4px;color:#6a746c;\n  }\n  /* 正文区撑满剩余高度，内容垂直居中分布 */\n  .card-body{\n    margin-top:22px;flex:1 1 auto;min-height:0;\n    display:flex;flex-direction:column;justify-content:center;\n  }\n  .key{\n    font-family:var(--serif);font-size:36px;line-height:1.55;font-weight:700;\n    letter-spacing:1.2px;color:#18211b;\n  }\n  .key em{\n    font-style:normal;color:var(--p);\n    background:linear-gradient(180deg,transparent 68%,rgba(79,94,67,.16) 68%);\n  }\n  .sub-line{\n    margin-top:28px;font-size:17px;line-height:2;color:var(--muted);letter-spacing:.7px;\n  }\n  .strong{font-size:25px;line-height:1.7;font-weight:700;color:#232e26;letter-spacing:.8px;}\n  .mini-rule{height:1px;flex:none;background:rgba(27,38,32,.18);margin:26px 0;}\n  .note{font-size:21px;line-height:2.1;color:#39443b;letter-spacing:.6px;}\n  .marker{\n    display:inline-block;align-self:flex-start;margin-top:34px;padding:6px 13px;\n    border:1px dashed rgba(140,159,178,.85);border-radius:2px;\n    font-size:13.5px;font-weight:700;letter-spacing:3px;color:#5f7285;\n    background:rgba(140,159,178,.10);\n  }\n  /* 底部标签贴底对齐 */\n  .card-foot{\n    margin-top:auto;flex:none;\n    font-size:13px;font-weight:600;letter-spacing:3px;color:#8b938c;\n    border-top:1px solid rgba(27,38,32,.12);padding-top:12px;\n  }\n\n  /* ---------- footer ---------- */\n  .foot-rule{position:absolute;left:96px;top:960px;width:1728px;height:1px;z-index:6;background:rgba(27,38,32,.22);}\n  .foot-left{\n    position:absolute;left:96px;top:982px;z-index:12;\n    font-size:14px;font-weight:600;letter-spacing:3.2px;color:#6d7770;\n  }\n  .foot-left span{color:rgba(27,38,32,.30);margin:0 12px;}\n  .page-no{\n    position:absolute;right:96px;top:978px;z-index:15;\n    font-size:16px;font-weight:700;letter-spacing:3px;color:#4f5b53;\n  }\n  .page-no b{font-family:var(--serif);font-size:26px;color:#18211b;margin-right:6px;letter-spacing:1px;}\n</style>\n</head>\n<body>\n<main class=\"slide\">\n  <div class=\"bg-field\"></div>\n  <div class=\"dot-field dot-top\"></div>\n  <div class=\"dot-field dot-bottom\"></div>\n  <div class=\"soft-prism\"></div>\n  <div class=\"gridline gl1\"></div>\n  <div class=\"gridline gl2\"></div>\n  <div class=\"gridline gl3\"></div>\n\n  <div class=\"top-rule\"></div>\n  <div class=\"left-rule\"></div>\n  <div class=\"rail-tick t1\"></div>\n  <div class=\"rail-tick t2\"></div>\n  <div class=\"rail-tick t3\"></div>\n  <div class=\"rail-label\">拟 议 方 向 · 待 检 验</div>\n\n  <div class=\"register\">\n    <div class=\"r2\"></div>\n    <div class=\"r3\"></div>\n    <div class=\"r4\"></div>\n    <div class=\"r5\"></div>\n    <div class=\"tick\"></div>\n    <div class=\"dot\"></div>\n  </div>\n\n  <div class=\"top-meta\">虚构隔振支架研究开题 · 研究开题评审</div>\n\n  <div class=\"kicker\">05<span class=\"sep\">/</span><span class=\"sub\">拟议创新点</span></div>\n  <div class=\"chip\"><i></i>拟议阶段</div>\n  <h1>拟议创新点</h1>\n\n  <div class=\"head-rule\"></div>\n  <div class=\"lead\">本页陈述<b>拟议创新点</b>、其<b>表述边界</b>与<b>检验条件</b>；以下内容为拟议方向，非已完成的实验结论。</div>\n\n  <div class=\"card c1\">\n    <div class=\"card-top\"><span class=\"num\">01</span><span class=\"tag\">拟议创新点</span></div>\n    <div class=\"card-body\">\n      <div class=\"key\">连接参数与多工况响应的<em>联合分析</em></div>\n      <div class=\"sub-line\">拟议创新点即在于上述两个方面的联合分析。</div>\n    </div>\n    <div class=\"card-foot\">POSITION · 拟议</div>\n  </div>\n\n  <div class=\"card c2\">\n    <div class=\"card-top\