er-radius:50%;border:1px solid rgba(27,38,32,.18);}\n  .register .r3{\n    position:absolute;inset:25px;border-radius:50%;\n    background:conic-gradient(from 210deg,rgba(79,94,67,.20),rgba(79,94,67,0) 24%,rgba(140,159,178,.30) 50%,rgba(140,159,178,.08) 78%,rgba(79,94,67,.20));\n  }\n  .register .r4{position:absolute;inset:34px;border-radius:50%;background:rgba(245,242,233,.88);border:1px solid rgba(27,38,32,.08);}\n  .register .r5{position:absolute;inset:50px;border-radius:50%;background:rgba(140,159,178,.25);border:1px solid rgba(27,38,32,.09);}\n  .register .dot{\n    position:absolute;left:48px;top:165px;width:14px;height:14px;border-radius:50%;\n    background:var(--theme-accent-secondary);box-shadow:0 0 0 5px rgba(180,145,74,.13);\n  }\n  .register .tick{position:absolute;left:-66px;top:145px;width:50px;height:1px;background:rgba(27,38,32,.32);}\n\n  /* ---------- 左侧标题区 ---------- */\n  .title-block{position:absolute;left:96px;top:152px;width:620px;z-index:12;}\n  .kicker{\n    display:flex;align-items:center;gap:16px;\n    font-size:14px;font-weight:600;letter-spacing:4.5px;color:#6f7a6d;\n  }\n  .kicker .num{\n    font-family:var(--font-display);font-size:22px;letter-spacing:1px;color:var(--theme-accent-secondary);\n  }\n  .kicker .bar{width:52px;height:1px;background:rgba(27,38,32,.34);}\n  .page-title{\n    margin:18px 0 0 0;\n    font-family:var(--font-display);\n    font-size:104px;\n    line-height:1.04;\n    letter-spacing:8px;\n    font-weight:600;\n    color:#1B2620;\n  }\n  .title-rule{width:200px;height:2px;background:var(--theme-accent-primary);opacity:.55;margin:26px 0 22px;}\n  .lead{\n    font-size:21px;line-height:1.75;color:#4d584f;letter-spacing:.6px;max-width:560px;\n  }\n\n  /* ---------- 口号卡 ---------- */\n  .slogan-card{\n    position:absolute;left:96px;top:590px;width:620px;z-index:12;\n    background:rgba(243,240,231,.92);\n    border:1px solid rgba(27,38,32,.14);\n    border-left:4px solid var(--theme-accent-secondary);\n    padding:3