ntent:\"\";position:absolute;left:88px;top:0;width:66px;height:1500px;background:rgba(255,255,255,.34);}\n\n  .edge-prism{position:absolute;z-index:2;left:1856px;top:230px;width:240px;height:900px;transform:rotate(15deg);transform-origin:top left;opacity:.9;\n    background:linear-gradient(180deg,rgba(79,94,67,.14),rgba(140,159,178,.10) 60%,rgba(140,159,178,0));}\n\n  .gridline{position:absolute;z-index:2;background:rgba(27,38,32,.06);}\n  .gl1{left:480px;top:0;width:1px;height:1080px;}\n  .gl2{left:960px;top:0;width:1px;height:1080px;}\n  .gl3{left:1440px;top:0;width:1px;height:1080px;}\n\n  .top-rule{position:absolute;left:96px;top:48px;width:1728px;height:1px;z-index:6;background:rgba(27,38,32,.34);}\n  .left-rule{position:absolute;left:60px;top:40px;width:1px;height:1000px;z-index:6;background:rgba(27,38,32,.26);}\n  .rail-tick{position:absolute;left:54px;width:13px;height:1px;z-index:7;background:rgba(27,38,32,.42);}\n  .rail-tick.t1{top:300px;}\n  .rail-tick.t2{top:620px;}\n  .rail-tick.t3{top:930px;}\n\n  .top-meta{position:absolute;left:98px;top:61px;z-index:15;font-size:15px;font-weight:600;letter-spacing:4.2px;color:#4f5b53;}\n  .rail-label{position:absolute;left:44px;top:545px;width:420px;height:24px;z-index:15;transform:rotate(-90deg);transform-origin:left top;\n    font-size:13px;font-weight:600;letter-spacing:5px;color:#637067;white-space:nowrap;}\n\n  /* ---------- 右上罗盘 ---------- */\n  .register{position:absolute;right:-7px;top:-60px;width:260px;height:260px;z-index:4;border-radius:50%;border:1px solid rgba(27,38,32,.38);}\n  .register .r2{position:absolute;inset:10px;border-radius:50%;border:1px solid rgba(27,38,32,.20);}\n  .register .r3{position:absolute;inset:25px;border-radius:50%;\n    background:conic-gradient(from 210deg,rgba(79,94,67,.20),rgba(79,94,67,0) 24%,rgba(140,159,178,.30) 50%,rgba(140,159,178,.08) 78%,rgba(79,94,67,.20));}\n  .register .r4{position:absolute;inset:34px;border-radius:50%;background:rgba(245,242,233,.88);border:1px solid rgba(27,38,32,.08);}\n  .register .r5{position:absolute;inset:50px;border-radius:50%;background:rgba(140,159,178,.25);border:1px solid rgba(27,38,32,.09);}\n  .register .dot{position:absolute;left:48px;top:165px;width:14px;height:14px;border-radius:50%;background:var(--p2);box-shadow:0 0 0 5px rgba(180,145,74,.13);}\n  .register .tick{position:absolute;left:-66px;top:145px;width:50px;height:1px;background:rgba(27,38,32,.34);}\n\n  /* ---------- 标题区 ---------- */\n  .head{position:absolute;left:96px;top:146px;width:1200px;z-index:12;}\n  .eyebrow{display:flex;align-items:center;gap:18px;font-size:14px;font-weight:700;letter-spacing:5px;color:#6b756c;}\n  .eyebrow i{display:block;width:74px;height:2px;background:var(--p2);}\n  h1{margin:22px 0 0;font-family:var(--serif);font-weight:400;font-size:96px;line-height:1.02;letter-spacing:3px;color:#1B2620;}\n  .subtitle{margin:24px 0 0;font-size:26px;letter-spacing:1.6px;color:#48544c;}\n  .subtitle b{font-weight:700;color:var(--p1);}\n  .head-note{margin:14px 0 0;font-size:17px;letter-spacing:1.2px;color:#77817a;}\n\n  /* ---------- 双卡 ---------- */\n  .card{position:absolute;top:452px;width:840px;height:356px;z-index:10;\n    background:rgba(243,240,231,.74);border:1px solid rgba(27,38,32,.20);padding:34px 40px 28px;}\n  .card-done{left:96px;}\n  .card-todo{left:984px;background:rgba(243,240,231,.60);}\n  .card:before{content:\"\";position:absolute;left:-1px;top:-1px;width:120px;height:3px;}\n  .card-done:before{background:var(--p1);}\n  .card-todo:before{background:var(--p2);}\n  .card-head{display:flex;align-items:center;gap:16px;height:24px;}\n  .tag{display:flex;align-items:center;font-size:19px;font-weight:700;letter-spacing:2px;color:var(--p1);}\n  .tag:before{content:\"\";display:block;width:10px;height:10px;margin-right:11px;background:var(--p1);}\n  .tag-gold{color:#8c6f33;}\n  .tag-gold:before{background:var(--p2);}\n  .tag-en{font-size:12px;font-weight:600;letter-spacing:4px;color:#8b958c;}\n  h2{margin:14px 0 0;font-family:var(--serif);font-weight:400;font-size:34px;line-height:1.2;letter-spacing:1.6px;color:#1B2620;}\n\n  .metrics{display:flex;gap:36px;margin-top:26px;}\n  .metric{flex:1;border-top:1px solid rgba(27,38,32,.26);padding-top:12px;}\n  .m-label{font-size:14px;letter-spacing:2px;color:#77817a;}\n  .m-num{font-family:var(--serif);font-size:58px;line-height:1.06;color:var(--p1);}\n  .m-num span{font-family:var(--sans);font-size:19px;letter-spacing:2px;color:#6b756c;margin-left:9px;}\n  .card-note{margin:24px 0 0;font-size:15px;line-height:1.65;letter-spacing:.6px;color:#667066;}\n\n  .todo-list{margin:24px 0 0;padding:0;list-style:none;}\n  .todo-list li{display:flex;align-items:center;height:30px;font-size:22px;letter-spacing:1.4px;color:#3c473e;}\n  .todo-list li span.bullet{display:block;width:22px;height:1px;background:var(--p2);margin-right:16px;}\n  .todo-list li em{font-style:normal;font-size:14px;letter-spacing:2px;color:#949c94;margin-left:14px;}\n\n  /* ---------- 页脚 ---------- */\n  .foot{position:absolute;left:96px;top:848px;width:1728px;z-index:12;\n    border-top:1px solid rgba(27,38,32,.30);padding-top:26px;display:flex;justify-content:space-between;align-items:flex-start;}\n  .foot-left{width:1080px;}\n  .foot-label{font-size:13px;font-weight:700;letter-spacing:5px;color:#7a847b;}\n  .foot-left p{margin:12px 0 0;font-size:16px;line-height:1.7;letter-spacing:.6px;color:#5C665D;}\n  .foot-left p strong{color:#3c473e;font-weight:700;}\n  .foot-right{display:flex;flex-direction:column;align-items:flex-end;padding-top:2px;}\n  .thanks{font-family:var(--serif);font-size:56px;line-height:1.1;letter-spacing:10px;color:var(--p1);}\n  .thanks-rule{width:280px;height:2px;background:var(--p2);margin-top:16px;opacity:.8;}\n\n  .page-no{position:absolute;right:96px;bottom:40px;z-index:20;font-size:15px;font-weight:600;letter-spacing:3px;color:#657066;}\n</style>\n</head>\n<body>\n<main class=\"slide\">\n  <div class=\"bg-field\"></div>\n  <div class=\"dot