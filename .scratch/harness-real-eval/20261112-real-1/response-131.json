px;letter-spacing:1.4px;color:#6A756C}\n.ruler .mo:last-child{border-right:1px solid rgba(27,38,32,.20)}\n.band{display:grid;grid-template-columns:repeat(8,1fr);height:10px;margin-top:8px}\n.band div{height:10px;margin-right:8px}\n.seg1{grid-column:1/3;background:var(--green)}\n.seg2{grid-column:3/6;background:var(--gold)}\n.seg3{grid-column:6/9;background:var(--blue)}\n.cards{display:grid;grid-template-columns:repeat(8,1fr);margin-top:26px}\n.card{position:relative;min-height:206px;padding:26px 34px 0 24px;border-left:1px solid rgba(27,38,32,.18)}\n.card.c1{grid-column:1/3}\n.card.c2{grid-column:3/6}\n.card.c3{grid-column:6/9}\n.card .bar{width:46px;height:4px;margin-bottom:20px}\n.c1 .bar{background:var(--green)}\n.c2 .bar{background:var(--gold)}\n.c3 .bar{background:var(--blue)}\n.card .tag{font-size:15px;font-weight:600;letter-spacing:3.6px;margin-bottom:14px}\n.c1 .tag{color:#3F4C36}\n.c2 .tag{color:var(--gold-deep)}\n.c3 .tag{color:#5E7183}\n.card .months{font-family:var(--serif);font-size:42px;line-height:1.12;letter-spacing:1px;color:#1B2620}\n.card .task{margin-top:14px;font-size:23px;line-height:1.4;letter-spacing:.6px;color:#3A473F}\n/* ---------- basis ---------- */\n.basis{position:absolute;left:96px;top:744px;width:1728px;z-index:9}\n.b-head{display:flex;align-items:baseline;gap:26px}\n.b-tag{flex:none;font-size:16px;font-weight:600;letter-spacing:3.4px;color:var(--gold-deep);\n  border-left:4px solid var(--gold);padding-left:14px;line-height:1.1}\n.b-text{font-size:26px;line-height:1.4;letter-spacing:.8px;color:#26322B;margin:0}\n.kpis{display:grid;grid-template-columns:repeat(4,1fr);margin-top:30px;\n  border-top:1px solid rgba(27,38,32,.22);padding-top:22px}\n.kpi{padding-left:30px;border-left:1px solid rgba(27,38,32,.14)}\n.kpi.first{padding-left:0;border-left:none}\n.k-num{font-family:var(--serif);font-size:56px;line-height:.95;color:var(--green);font-weight:600}\n.k-num small{font-family:var(--sans);font-size:19px;font-weight:600;letter-spacing:1px;\n  color:#5C665D;margin-left:10px}\n.k-lab{margin-top:12px;font-size:17px;letter-spacing:2.2px;color:#55615A}\n/* ---------- footer ---------- */\n.foot-note{position:absolute;left:96px;top:986px;z-index:12;font-size:16px;letter-spacing:1.4px;color:#6A756C}\n.foot-note span{display:inline-block;width:26px;height:1px;background:rgba(27,38,32,.4);\n  vertical-align:4px;margin-right:12px}\n.page-no{position:absolute;right:96px;bottom:44px;z-index:15;font-size:16px;font-weight:600;\n  letter-spacing:2.4px;color:#55615A}\n.page-no:before{content:\"\";display:inline-block;width:34px;height:1px;background:rgba(27,38,32,.4);\n  vertical-align:5px;margin-right:14px}\n</style>\n</head>\n<body>\n<main class=\"slide\">\n  <div class=\"bg-field\"></div>\n  <div class=\"gridline gl1\"></div>\n  <div class=\"gridline gl2\"></div>\n  <div class=\"gridline gl3\"></div>\n  <div class=\"dot-field\"></div>\n  <div class=\"edge-prism\"></div>\n\n  <div class=\"top-rule\"></div>\n  <div class=\"left-rule\"></div>\n  <div class=\"rail-label\">FEASIBILITY &amp; SCHEDULE</div>\n\n  <header class=\"header\">\n    <div class=\"kicker\">研究开题评审 · 计划安排</div>\n    <h1 class=\"h-title\">可行性与进度</h1>\n    <div class=\"head-rule\"></div>\n    <p class=\"lead\">计划周期 8 个月，按三阶段推进</p>\n  </header>\n\n  <div class=\"cycle\">\n    <div class=\"rule\"></div>\n    <div class=\"num\">8<em>个月</em></div>\n    <div class=\"cap\">计划周期</div>\n  </div>\n\n  <section class=\"timeline\">\n    <div class=\"ruler\">\n      <div class=\"mo\">第 1 月</div>\n      <div class=\"mo\">第 2 月</div>\n      <div class=\"mo\">第 3 月</div>\n      <div class=\"mo\">第 4 月</div>\n      <div class=\"mo\">第 5 月</div>\n      <div class=\"mo\">第 6 月</div>\n      <div class=\"mo\">第 7 月</div>\n      <div class=\"mo\">第 8 月</div>\n    </div>\n    <div class=\"band\">\n      <div class=\"seg1\"></div>\n      <div class=\"seg2\"></div>\n      <div class=\"seg3\"></div>\n    </div>\n    <div class=\"cards\">\n      <div class=\"card c1\">\n        <div class=\"bar\"></div>\n        <div class=\"tag\">阶段一</div>\n        <div class=\"months\">第 1–2 月</div>\n        <div class=\"task\">完成设计</div>\n      </div>\n      <div class=\"card c2\">\n        <div class=\"bar\"></div>\n        <div class=\"tag\">阶段二</div>\n        <div class=\"months\">第 3–5 月</div>\n        <div class=\"task\">试验准备与数据采集</div>\n      </div>\n      <div class=\"card c3\">\n        <div class=\"bar\"></div>\n        <div class=\"tag\">阶段三</div>\n        <div class=\"months\">第 6–8 月</div>\n        <div class=\"task\">对比分析与写作</div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"basis\">\n    <div class=\"b-head\">\n      <div class=\"b-tag\">可行性依据</div>\n      <p class=\"b-text\">试件、工况与测点数量及五步技术路线均已明确，方案具备可执行性</p>\n    </div>\n    <div class=\"kpis\">\n      <div class=\"kpi first\">\n        <div class=\"k-num\">18<small>件</small></div>\n        <div class=\"k-lab\">拟设试件</div>\n      </div>\n      <div class=\"kpi\">\n        <div class=\"k-num\">6<small>类</small></div>\n        <div class=\"k-lab\">设计工况</div>\n      </div>\n      <div class=\"kpi\">\n        <div class=\"k-num\">24<small>个</small></div>\n        <div class=\"k-lab\">拟设测点</div>\n      </div>\n      <div class=\"kpi\">\n        <div class=\"k-num\">5<small>步</small></div>\n        <div class=\"k-lab\">技术路线步骤</div>\n      </div>\n    </div>\n  </section>\n\n  <div class=\"foot-note\"><span></span>以上阶段划分与周期均为计划安排，不代表已完成工作</div>\n  <div class=\"page-no\">4 / 6</div>\n</main>\n</body>\n</html>","reasoning_content":"Let me create a single HTML page, 1920x1080, styled per reference: cream background, green/brown accents, serif display font (Bodoni-like → use Georgia/serif), sans-serif body (Helvetica/Arial). Chinese text needs proper font families: 'Songti SC', 'Noto Serif SC', Georgia for display; 'PingFang SC', 'Microsoft YaHei' for body.\n\nContent: title 可行性与进度, three-stage timeline (months 1-2, 3-5, 6-8), total 8 months, 可行性依据.\n\nLayout: title top-left,