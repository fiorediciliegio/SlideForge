# SlideForge 环境配置（复制为 .env 并填写）
OPENAI_API_KEY=sk-换成你的模型key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=deepseek-chat

# 管理员 token（/console 与 /admin/* 鉴权，生产必配）
SLIDEFORGE_ADMIN_TOKEN=换成随机长串

# Go 网关与 Node 引擎上游（P1 过渡架构）
GATEWAY_PORT=8080
# 业务 Node 保持一个逻辑实例；引擎可多实例拉取同一持久队列
GATEWAY_REPLICAS=1
ENGINE_UPSTREAM_URL=http://127.0.0.1:3210
NODE_ENGINE_URL=http://127.0.0.1:3211
BRAIN_URL=http://127.0.0.1:3212
GATEWAY_INTERNAL_TOKEN=换成独立的内部随机长串
# 可选：Go 认证计费 PostgreSQL；不配置则使用本地 JSON
# DATABASE_URL=postgres://slideforge:换成密码@127.0.0.1:5432/slideforge?sslmode=disable
# 可选独立任务库；缺省复用 DATABASE_URL，启用后任务通知与 webhook outbox 均使用 PostgreSQL
# JOBS_DATABASE_URL=postgres://slideforge:换成密码@127.0.0.1:5432/slideforge_jobs?sslmode=disable
# 可选独立文件库；启用文件 PostgreSQL 时必须同时配置 S3
# FILES_DATABASE_URL=postgres://slideforge:换成密码@127.0.0.1:5432/slideforge_files?sslmode=disable
# S3_ENDPOINT=https://s3.example.com
# S3_BUCKET=slideforge-exports
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=换成访问账号
# S3_SECRET_ACCESS_KEY=换成访问密钥
S3_FORCE_PATH_STYLE=true
SLIDEFORGE_MIGRATE_JSON=false
# 配置后 Node 不再读写 API key、余额或台账文件
SLIDEFORGE_BILLING_API_URL=http://127.0.0.1:8080/internal
# 配置后 Node 不再读写任务快照文件
SLIDEFORGE_JOB_API_URL=http://127.0.0.1:8080/internal/jobs
# 配置后 Node 导出完成即发布到 Go 文件服务，公共下载按 API key 隔离
SLIDEFORGE_FILE_API_URL=http://127.0.0.1:8080/internal/files

# Python 大脑层（模型与文档理解）；未配置时 Node 使用本地实现
BRAIN_HOST=127.0.0.1
BRAIN_PORT=3212
SLIDEFORGE_BRAIN_API_URL=http://127.0.0.1:3212/internal/brain

# Node 独立引擎服务（页面校验、预览与导出）
ENGINE_PORT=3211
ENGINE_WORK_ROOT=/var/lib/slideforge/engine-work
SLIDEFORGE_ENGINE_API_URL=http://127.0.0.1:8080/internal/engine
ENGINE_CONCURRENCY=1
AGENT_PROJECT_CONCURRENCY=5
AGENT_OWNER_PROJECT_CONCURRENCY=2
AGENT_PAGE_CONCURRENCY=3
PAGE_MODEL_CONCURRENCY=12

# 服务端口与容量保护（保持保守起点）
PORT=3210
NODE_ENV=production
DECK_CONCURRENCY=2
DECK_JOB_CONCURRENCY=5
DECK_QUEUE_SIZE=50
DECK_CREATE_PER_HOUR=20
RATE_LIMIT_PER_MINUTE=120
MAX_BODY_BYTES=33554432
SLIDEFORGE_DATA_DIR=/var/lib/slideforge/data
# 仅在受信反向代理后开启，用于按真实客户端 IP 限流
SLIDEFORGE_TRUST_PROXY=false

# 无头浏览器（Debian/Ubuntu 用 chromium 路径；安装见 deploy/install.sh）
CHROME_PATH=/usr/bin/chromium

SLIDEFORGE_WORKSPACE_DIR=/var/lib/slideforge/workspace
