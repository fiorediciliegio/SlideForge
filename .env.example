# Agent tool access policy: strict | warn | off. Use warn for local hosts that
# have not shipped granted_tools / inherit_host_tools support yet.
# VITE_AGENT_TOOL_ACCESS_POLICY=warn
# Internal test builds only. Shows Performance Testing controls in Settings.
# VITE_PERFORMANCE_TESTING_ENABLED=true
# Internal test builds only. Shows automated Batch Testing controls in Settings.
# VITE_BATCH_TESTING_ENABLED=true
# Internal test builds only. Shows the Web Research Lab entry in the developer sidebar.
# VITE_WEB_RESEARCH_LAB_ENABLED=true
# Internal troubleshooting builds only. Shows Agent resource information in Settings.
# VITE_AGENT_RESOURCE_INFO_ENABLED=true
# Internal troubleshooting builds only. Shows Workspace Diagnostic Bundle controls in Settings.
# VITE_WORKSPACE_DIAGNOSTIC_BUNDLE_ENABLED=true
# Internal image research testing only. Persists research, then stops before page generation.
# VITE_STOP_AFTER_IMAGE_RESEARCH=true
# Whether single-page HTML generation/refinement receives HTML_GENERATION_SYSTEM_PROMPT.
# Only the exact value "true" enables it; visual-master generation never receives it.
# VITE_HTML_GENERATION_SYSTEM_PROMPT_ENABLED=true

# 是否记录诊断日志 / Record diagnostic logs. Only true enables logging.
# 构建时生效；不影响生成进度和恢复状态。 / Build-time; preserves workflow state.
VITE_PPT_LOG_ENABLED=false
