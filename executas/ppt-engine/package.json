{
  "name": "slideforge-engine",
  "version": "6.0.13",
  "description": "SlideForge template engine: HTML slide workspace, rasterization and PPTX export",
  "private": true,
  "type": "module",
  "types": "./dist/index.d.ts",
  "files": [
    "manifest.json",
    "invoke-tools.json",
    "dist",
    "example_plugin.js",
    "invoke-context.js",
    "aps-files-client.js",
    "host-upload-confirmation.js",
    "host-upload-cache.js",
    "storage-retry.js",
    "pdf-ocr-runner.mjs",
    "build_binary.sh",
    "scripts/binary-release.mjs",
    "scripts/tool-manifest-validation.mjs",
    "scripts/patch-postject.mjs",
    "scripts/prepare-browser-runtime.mjs",
    "scripts/prepare-sea-bundle.mjs",
    "scripts/sea-bootstrap.cjs",
    "scripts/smoke-test-binary.mjs",
    "test/fixtures/binary-smoke-deck",
    "invoke-transport.js",
    "invoke-transport-server.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/http/server.d.ts",
      "import": "./dist/http/server.js"
    }
  },
  "bin": {
    "presenton-template-engine-server": "./dist/cli.js",
    "tool-lightvoss-ppt-engine-kqhra9hy": "./example_plugin.js"
  },
  "scripts": {
    "sync:engine-manifest": "node ../../scripts/sync-ppt-engine-manifest.mjs",
    "validate:manifest": "node ./scripts/tool-manifest-validation.mjs ./manifest.json ./invoke-tools.json",
    "prebuild": "npm run sync:engine-manifest && npm run validate:manifest",
    "dev": "tsx src/cli.ts",
    "build": "node ./scripts/build-template-registry.mjs && tsup && node ./scripts/build-tailwind-runtime.mjs && node ./scripts/build-dom-to-pptx-runtime.mjs && node ./scripts/build-authoring-kit.mjs && node ./scripts/build-forkable-templates.mjs",
    "audit:layout": "node --import tsx/esm src/layout-audit/cli.ts",
    "preview:tsx": "node --import tsx/esm ./scripts/preview-page-source.ts",
    "precheck": "npm run validate:manifest",
    "check": "tsc --noEmit",
    "test:unit": "node ./scripts/run-isolated-tests.mjs",
    "test:snapshot-trigger-race": "node --import tsx/esm --test --test-concurrency=1 test/app-workspace/snapshot-create-flow-trigger-race.test.ts",
    "test:snapshot-retry-budget": "node --import tsx/esm --test --test-concurrency=1 test/app-workspace/snapshot-retry-budget.test.ts",
    "test:snapshot-reconcile-classification": "node --import tsx/esm --test --test-concurrency=1 test/app-workspace/snapshot-reconcile-classification.test.ts",
    "snapshot-upload-test-gate": "node ./scripts/snapshot-upload-test-gate.mjs",
    "snapshot-reconcile-local-ahead-test": "node ./scripts/snapshot-reconcile-local-ahead-test.mjs",
    "start": "node dist/cli.js",
    "start:plugin": "node example_plugin.js",
    "build:binary": "./build_binary.sh",
    "test": "node -e \"console.log('No vendored automated tests in this example package')\""
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.100",
    "@tailwindcss/browser": "4.3.2",
    "ajv": "^8.20.0",
    "archiver": "^8.0.0",
    "esbuild": "^0.27.4",
    "fonteditor-core": "2.6.3",
    "jszip": "^3.10.1",
    "mammoth": "^1.10.0",
    "parse5": "^7.3.0",
    "pdfjs-dist": "^5.4.296",
    "postcss": "^8.5.28",
    "postcss-value-parser": "^4.2.0",
    "pptx-svg": "^0.6.4",
    "puppeteer": "24.40.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.15.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0",
    "tsx": "^4.20.6",
    "turndown": "^7.2.0",
    "typescript": "^5.9.2",
    "use-resize-observer": "^9.1.0",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@types/archiver": "^8.0.0",
    "@types/node": "^20.19.17",
    "@types/react": "^18.3.24",
    "@types/turndown": "^5.0.5",
    "postject": "^1.0.0-alpha.6",
    "tsup": "^8.5.0"
  },
  "engines": {
    "node": ">=22"
  },
  "pkg": {
    "assets": [
      "manifest.json",
      "invoke-tools.json",
      "dist/browser/*.global.js",
      "dist/vendor/dom-to-pptx/**/*",
      "dist/forkable-templates/**/*",
      "dist/authoring-kit/**/*",
      "node_modules/**/*.cjs",
      "node_modules/**/*.mjs",
      "node_modules/**/*.wasm",
      "node_modules/**/*.json"
    ],
    "scripts": [
      "dist/**/*.js",
      "node_modules/**/*.js"
    ]
  }
}
